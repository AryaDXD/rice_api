  "item": [
    {
      "name": "Bulk Student Upload",
      "item": [
        {
          "name": "1. List Student Endpoints",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bulk-upload/endpoints",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bulk-upload",
                "endpoints"
              ]
            },
            "description": "Returns all student creation endpoints (Production, Testing/UAT, Rice Edu) available in the system."
          }
        },
        {
          "name": "2. Download Excel Template",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bulk-upload/template.xlsx",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bulk-upload",
                "template.xlsx"
              ]
            },
            "description": "Downloads sample Excel (.xlsx) template with required column names."
          }
        },
        {
          "name": "3. Download CSV Template",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bulk-upload/template.csv",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bulk-upload",
                "template.csv"
              ]
            },
            "description": "Downloads sample CSV template with required column names."
          }
        },
        {
          "name": "4. Parse Spreadsheet File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "batchUniqueId",
                  "value": "RSMSMPSC2627001",
                  "type": "text"
                },
                {
                  "key": "classStartDate",
                  "value": "11/6/2026",
                  "type": "text"
                },
                {
                  "key": "secondaryLangauge",
                  "value": "hindi",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/bulk-upload/parse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bulk-upload",
                "parse"
              ]
            },
            "description": "Parses and validates an uploaded Excel (.xlsx) or CSV file."
          }
        },
        {
          "name": "5. Execute Bulk Student Upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint_id\": \"2\",\n  \"students\": [\n    {\n      \"firstName\": \"ALOKPARNA\",\n      \"middleName\": \"\",\n      \"lastName\": \"KAR\",\n      \"primaryEmail\": \"alokparnakar@gmail.com\",\n      \"secondaryEmail\": \"\",\n      \"contactNo\": \"9051496355\",\n      \"address\": \"kolkata\",\n      \"batchUniqueId\": \"RSMSMPSC2627001\",\n      \"studentUniqueId\": \"2627/RICESMART/377\",\n      \"secondaryLangauge\": \"hindi\",\n      \"classStartDate\": \"11/6/2026\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bulk-upload/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bulk-upload",
                "submit"
              ]
            },
            "description": "Uploads students in bulk to selected LMS endpoint (e.g. endpoint_id 2 for Production or 0 for Testing/UAT)."
          }
        }
      ]
    },
